# Worker-only values: set secrets with `wrangler secret put`, never VITE_ prefixed.
SEEDR_MODE=mock
# Use npm run seedr:configure for a private single-account live V1 connection.
# SEEDR_ACCESS=full enables app-managed file actions and Cron.
# SEEDR_ACCESS=storage-only disables all file actions and Cron cleanup.
# D1 DB is a Worker binding in apps/worker/wrangler.toml, not a credential.
ALLOWED_ORIGIN=http://localhost:5173
MAX_FILE_SIZE_BYTES=5368709120
MAX_ACTIVE_DOWNLOADS=8
SUBMISSION_COOLDOWN_SECONDS=30
# JSON array; credentials themselves are Worker secrets keyed by secretKeyReference.
SEEDR_ACCOUNT_CONFIG=[{"id":"seedr-a","label":"Seedr A","enabled":true,"capacityBytes":5368709120,"secretKeyReference":"SEEDR_ACCOUNT_A_TOKEN"},{"id":"seedr-b","label":"Seedr B","enabled":true,"capacityBytes":4831838208,"secretKeyReference":"SEEDR_ACCOUNT_B_TOKEN"}]
# Tokens are private Worker secrets, not values in the JSON account metadata.
# Required PAT scopes: account.read, files.read/write, tasks.read/write, media.read.
# Optional in production only. Leave blank to disable Turnstile verification.
TURNSTILE_SECRET_KEY=
