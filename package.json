{
  "name": "temporary-seedr-share",
  "private": true,
  "version": "0.1.0",
  "packageManager": "npm@11.19.1",
  "workspaces": ["apps/*", "packages/*"],
  "scripts": {
    "dev": "node scripts/dev.mjs",
    "dev:web": "npm run dev --workspace=@temporary-share/web",
    "dev:worker": "npm run dev --workspace=@temporary-share/worker",
    "build": "npm run build --workspaces --if-present",
    "lint": "npm run lint --workspaces --if-present",
    "typecheck": "npm run typecheck --workspaces --if-present",
    "test": "npm run test --workspace=@temporary-share/worker && npm run test:seedr-connection && node scripts/admin-setup.test.mjs",
    "test:seedr-connection": "node scripts/seedr-check.test.mjs",
    "seedr:check": "powershell -NoProfile -File scripts/seedr-connect.ps1",
    "seedr:configure": "powershell -NoProfile -File scripts/seedr-connect.ps1 -Configure",
    "admin:setup": "powershell -NoProfile -File scripts/admin-setup.ps1",
    "admin:setup:production": "powershell -NoProfile -File scripts/admin-setup.ps1 -Production",
    "db:migrate:local": "npm run db:migrate:local --workspace=@temporary-share/worker",
    "db:migrate:remote": "npm run db:migrate:remote --workspace=@temporary-share/worker"
  },
  "devDependencies": {"typescript": "^5.9.3"}
}
